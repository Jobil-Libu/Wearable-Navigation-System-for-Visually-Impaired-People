[Unit]
Description=Assistive Tech - Smart Cane Companion (startup_manager.py)
# Wait for basic system + sound to be ready before starting
After=multi-user.target sound.target
Wants=sound.target

[Service]
Type=simple

# --- EDIT THESE THREE LINES to match your actual Pi setup ---
User=pi
WorkingDirectory=/home/pi/Desktop/AssistiveTech
ExecStart=/home/pi/Desktop/AssistiveTech/yolo-env/bin/python /home/pi/Desktop/AssistiveTech/startup_manager.py
# ---------------------------------------------------------------

# Needed so paplay/pygame can reach the user's PulseAudio session
# when this runs as a system service instead of a login shell.
# If your Pi user's UID isn't 1000, change that number to match
# (check with: id -u pi)
Environment=XDG_RUNTIME_DIR=/run/user/1000

# Auto-restart if it crashes (e.g. the USB voltage-drop issue in the README)
Restart=on-failure
RestartSec=5

# Send stdout/stderr to the journal so `journalctl -u assistivetech.service -f` works
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
